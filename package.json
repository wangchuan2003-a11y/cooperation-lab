{
  "name": "cooperation-lab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4199 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
